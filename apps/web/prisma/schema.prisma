generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "sqlite"
}
model Record {
  id String @id @default(uuid())
  kind String
  title String
  body String @default("")
  status String @default("ACTIVE")
  version Int @default(1)
  archivedAt DateTime?
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  domain Domain?
  course Course?
  project Project?
  action Action?
  issue Issue?
  resource Resource?
  review Review?
  person Person?
  item Item?
  account Account?
  transaction Transaction?
  budget Budget?
  channel Channel?
  publication Publication?
  outgoing RecordLink[] @relation("From")
  incoming RecordLink[] @relation("To")
  tags RecordTag[]
  attachments Attachment[]
  revisions Revision[]
  @@index([kind, deletedAt, archivedAt])
}
model Domain {
  recordId String @id
  record Record @relation(fields: [recordId], references: [id])
  group String @default("个人成长")
  focus String @default("")
}
model Course {
  recordId String @id
  record Record @relation(fields: [recordId], references: [id])
  semester String @default("")
  chapters String @default("")
  criteria String @default("")
}
model Project {
  recordId String @id
  record Record @relation(fields: [recordId], references: [id])
  outcome String @default("")
  criteria String @default("")
  stage String @default("构想")
  nextStep String @default("")
  milestones String @default("")
  decisions String @default("")
  weeklyCommitment Boolean @default(false)
}
model Action {
  recordId String @id
  record Record @relation(fields: [recordId], references: [id])
  plannedAt DateTime?
  dueAt DateTime?
  remindAt DateTime?
  priority Int @default(2)
  estimatedMinutes Int?
  important Boolean?
  urgent Boolean?
  blocker String @default("")
  repeat String @default("NONE")
  parentId String?
  previousId String? @unique
  todayFocus Boolean @default(false)
  completedAt DateTime?
}
model Issue {
  recordId String @id
  record Record @relation(fields: [recordId], references: [id])
  observation String @default("")
  impact String @default("")
  hypothesis String @default("")
  experiment String @default("")
  checkAt DateTime?
  result String @default("")
}
model Resource {
  recordId String @id
  record Record @relation(fields: [recordId], references: [id])
  url String @default("")
  author String @default("")
  resourceType String @default("网站")
  assessment String @default("")
}
model Review {
  recordId String @id
  record Record @relation(fields: [recordId], references: [id])
  scope String @default("周复盘")
  expected String @default("")
  actual String @default("")
  adjustment String @default("")
  snapshots String @default("[]")
}
model Person {
  recordId String @id
  record Record @relation(fields: [recordId], references: [id])
  entityType String @default("人物")
  organization String @default("")
  contact String @default("")
  experiences String @default("")
  followUpAt DateTime?
}
model Item {
  recordId String @id
  record Record @relation(fields: [recordId], references: [id])
  location String @default("")
  quantity Int @default(1)
  maintenanceAt DateTime?
}
model Account {
  recordId String @id
  record Record @relation(fields: [recordId], references: [id])
  openingCents Int @default(0)
  currency String @default("CNY")
  transactions Transaction[]
}
model Transaction {
  recordId String @id
  record Record @relation(fields: [recordId], references: [id])
  accountId String
  account Account @relation(fields: [accountId], references: [recordId])
  amountCents Int
  direction String @default("OUT")
  category String @default("其他")
  occurredAt DateTime @default(now())
}
model Budget {
  recordId String @id
  record Record @relation(fields: [recordId], references: [id])
  category String @default("其他")
  period String
  limitCents Int
}
model Channel {
  recordId String @id
  record Record @relation(fields: [recordId], references: [id])
  channel String @default("博客")
  url String @default("")
  publishedAt DateTime?
}
model Publication {
  recordId String @id
  record Record @relation(fields: [recordId], references: [id])
  publicationType String @default("article")
  slug String @unique
  summary String @default("")
  details String @default("{}")
  selectedAssets String @default("[]")
  currentVersionId String?
  versions PublishedVersion[]
}
model PublishedVersion {
  id String @id @default(uuid())
  publicationId String
  publication Publication @relation(fields: [publicationId], references: [recordId])
  snapshot String
  createdAt DateTime @default(now())
  assets PublishedAsset[]
}
model RecordLink {
  id String @id @default(uuid())
  fromId String
  toId String
  relation String @default("related")
  from Record @relation("From", fields: [fromId], references: [id])
  to Record @relation("To", fields: [toId], references: [id])
  @@unique([fromId, toId, relation])
}
model Tag {
  id String @id @default(uuid())
  name String @unique
  aliases String @default("")
  records RecordTag[]
}
model RecordTag {
  recordId String
  tagId String
  record Record @relation(fields: [recordId], references: [id])
  tag Tag @relation(fields: [tagId], references: [id])
  @@id([recordId, tagId])
}
model Attachment {
  id String @id @default(uuid())
  recordId String
  record Record @relation(fields: [recordId], references: [id])
  name String
  mime String
  size Int
  storageKey String @unique
  createdAt DateTime @default(now())
}
model PublishedAsset {
  id String @id @default(uuid())
  versionId String
  version PublishedVersion @relation(fields: [versionId], references: [id])
  name String
  mime String
  storageKey String @unique
}
model Revision {
  id String @id @default(uuid())
  recordId String
  record Record @relation(fields: [recordId], references: [id])
  snapshot String
  createdAt DateTime @default(now())
}
model Owner {
  id String @id @default("owner")
  username String @unique
  passwordHash String
}
model Session {
  tokenHash String @id
  expiresAt DateTime
}
model LoginAttempt {
  key String @id
  count Int @default(0)
  windowAt DateTime @default(now())
}
model Setting {
  key String @id
  value String
}

model AiConversation {
  id String @id @default(uuid())
  ownerId String @default("owner")
  title String @default("新对话")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages AiMessage[]
  runs AiRun[]
}
model AiMessage {
  id String @id @default(uuid())
  conversationId String
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role String
  parts String @default("[]")
  status String @default("COMPLETE")
  schemaVersion Int @default(1)
  createdAt DateTime @default(now())
  @@index([conversationId, createdAt])
}
model AiRun {
  id String @id @default(uuid())
  conversationId String
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  clientTurnId String
  mode String
  provider String
  model String
  status String @default("RUNNING")
  activeOwnerKey String? @unique
  sessionHash String
  leaseToken String
  leaseExpiresAt DateTime
  input String
  assistantMessageId String
  usage String?
  errorCode String?
  toolCount Int @default(0)
  createCount Int @default(0)
  createdAt DateTime @default(now())
  finishedAt DateTime?
  operations AiOperation[]
  events AiRunEvent[]
  @@unique([conversationId, clientTurnId])
}
model AiOperation {
  id String @id @default(uuid())
  runId String
  run AiRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolCallId String
  type String
  status String
  payload String
  hash String
  recordId String?
  expectedVersion Int?
  before String @default("{}")
  result String @default("{}")
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@unique([runId, toolCallId])
}
model AiRunEvent {
  id Int @id @default(autoincrement())
  runId String
  run AiRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  type String
  data String
  createdAt DateTime @default(now())
  @@index([runId, id])
}
model AiRateLimit {
  key String @id
  windowAt DateTime
  count Int
}

model MobilePairing {
  codeHash String @id
  expiresAt DateTime
}
model MobileSession {
  id String @id @default(uuid())
  tokenHash String @unique
  label String
  createdAt DateTime @default(now())
  expiresAt DateTime
  mutations MobileMutation[]
}
model MobileMutation {
  id String @id
  sessionId String
  session MobileSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  requestHash String
  recordId String
}
