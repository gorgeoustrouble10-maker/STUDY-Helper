# 数据目录（相对路径基于项目根目录解析；CLI 与运行时都会得到同一绝对路径）
DATA_DIR=./.data

# 数据库文件通常无需单独设置。DATA_DIR 下的 garden.db 会同时用于 Prisma CLI 与运行时适配器。
# 如必须设置 DATABASE_URL，请使用绝对路径（file:C:/path/to/garden.db），
# 因为相对 file: 路径在 Prisma CLI 与 better-sqlite3 适配器中的解析基准不同，可能导致两处读写不同的数据库文件。
# DATABASE_URL=

# 浏览器实际访问的站点来源（协议+主机+端口），用于来源校验与 SEO 链接。
# 必须与真实访问地址完全一致（来源校验做精确匹配），否则登录等写操作会返回 403。
# 生产模式 `npm start` 绑定 0.0.0.0，必须设置此项；开发服务器默认绑定 http://127.0.0.1:3000。
SITE_URL=http://127.0.0.1:3000

# 会话有效期（天），1-30
SESSION_DAYS=7
