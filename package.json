{
  "name": "study-helper",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "install:all": "npm --prefix apps/web ci && npm --prefix apps/mobile ci",
    "dev": "npm run web:dev",
    "build": "npm run web:build",
    "start": "npm --prefix apps/web start",
    "setup": "npm --prefix apps/web run setup",
    "db:generate": "npm --prefix apps/web run db:generate",
    "db:migrate": "npm --prefix apps/web run db:migrate",
    "db:seed": "npm --prefix apps/web run db:seed",
    "owner:init": "npm --prefix apps/web run owner:init",
    "backup": "npm --prefix apps/web run backup --",
    "restore": "npm --prefix apps/web run restore --",
    "typecheck": "npm run web:typecheck && npm run mobile:typecheck",
    "check": "npm run typecheck && npm run mobile:lint && npm test",
    "test": "npm run web:test && npm run test:mobile-api && npm run mobile:test",
    "test:e2e": "npm --prefix apps/web run test:e2e --",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:typecheck": "npm --prefix apps/web run typecheck",
    "web:test": "npm --prefix apps/web test",
    "dev:lan": "npm --prefix apps/web run dev:lan",
    "mobile:prepare": "npm --prefix apps/web run mobile:prepare",
    "verify:mobile": "npm --prefix apps/web run verify:mobile",
    "mobile:start": "npm --prefix apps/mobile start",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:lint": "npm --prefix apps/mobile run lint",
    "mobile:test": "npm --prefix apps/mobile test",
    "mobile:apk": "npm --prefix apps/mobile run android:release",
    "server:start": "npm --prefix services/mobile-api start",
    "test:mobile-api": "npm --prefix services/mobile-api test"
  }
}
